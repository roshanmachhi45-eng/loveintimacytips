{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "loveons.com"
        }
      ],
      "destination": "https://loveons.com*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/share/tarot",
      "destination": "/api/tarot-share"
    },
    {
      "source": "/share/love-calculator",
      "destination": "/api/love-share"
    },
    {
      "source": "/((?!api|assets|images|favicon.ico|_next|loveons-logo.svg).*)" ,
      "destination": "/index.html"
    }
  ]
}











