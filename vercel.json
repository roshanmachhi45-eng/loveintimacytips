
{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/love-calculator",
      "destination": "/tools/love-calculator",
      "permanent": true
    },
    {
      "source": "/blog/how-to-meet-singles-without-dating-apps-the-ultimate-irl-guide",
      "destination": "/blog/how-to-meet-singles-without-dating-apps",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|svg|ico|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/share/tarot",
      "destination": "/api/tarot-share"
    },
    {
      "source": "/share/love-calculator",
      "destination": "/api/love-share"
    },
    {
      "source": "/((?!api|assets|images|\\.well-known|favicon.ico|_next|loveons-logo.svg).*)",
      "destination": "/index.html"
    }
  ]
}














